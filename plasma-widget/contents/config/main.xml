<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
                          https://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <kcfgfile name=""/>
  <group name="General">
    <entry name="tasksJson" type="String">
      <default>[]</default>
    </entry>
    <entry name="clipboardHistory" type="String">
      <default>[]</default>
    </entry>
    <entry name="focusSeconds" type="Int">
      <default>1500</default>
    </entry>
    <entry name="focusStartedAt" type="String">
      <default>0</default>
    </entry>
    <entry name="focusMode" type="String">
      <default>focus</default>
    </entry>
    <entry name="focusSessionsDate" type="String">
      <default></default>
    </entry>
    <entry name="focusSessionsToday" type="Int">
      <default>0</default>
    </entry>
    <entry name="theme" type="String">
      <default>midnight</default>
    </entry>
    <entry name="morningAgenda" type="Bool">
      <default>true</default>
    </entry>
    <entry name="eveningRecap" type="Bool">
      <default>true</default>
    </entry>
    <entry name="lastAgendaBriefing" type="String">
      <default></default>
    </entry>
    <entry name="lastAgendaRecap" type="String">
      <default></default>
    </entry>
    <entry name="waterReminder" type="Bool">
      <default>false</default>
    </entry>
    <entry name="lastWaterAt" type="String">
      <default>0</default>
    </entry>
    <entry name="prayerReminder" type="Bool">
      <default>false</default>
    </entry>
    <entry name="prayerCity" type="String">
      <default>Jakarta, Indonesia</default>
    </entry>
    <entry name="prayerMethod" type="Int">
      <default>20</default>
    </entry>
    <entry name="prayerCache" type="String">
      <default>{}</default>
    </entry>
    <entry name="lastPrayerNotice" type="String">
      <default></default>
    </entry>
  </group>
</kcfg>
